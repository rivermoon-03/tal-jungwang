# ============================================================================
# frontend/.env  — 이 파일을 .env 로 복사해서 채운다 (.env 는 커밋 금지)
#
#   cp frontend/.env.example frontend/.env
#
# Vite 는 VITE_ 접두사가 붙은 값만 클라이언트 번들에 주입한다.
# 여기 들어가는 값은 전부 브라우저에 그대로 노출되므로 비밀키는 절대 넣지 말 것.
# (VAPID 공개키는 백엔드의 GET /api/v1/push/vapid-public-key 로 받아온다.)
# ============================================================================

# ─── 카카오맵 JavaScript SDK ─────────────────────────────────────────────────
# Kakao Developers (https://developers.kakao.com) → 내 앱 → 앱 키 → JavaScript 키
# 클라이언트에 노출되는 키이므로 Kakao Developers에서 도메인 화이트리스트 등록 필수
VITE_KAKAO_JS_APP_KEY=

# ─── 웹 광고 비활성화 ────────────────────────────────────────────────────────
# 1 또는 true 이면 AdSense 스크립트를 아예 로드하지 않는다 (src/utils/ads.js).
# Android TWA / 설치형 PWA 전용 빌드에서 사용. 웹 배포용 빌드는 비워 둔다.
VITE_DISABLE_WEB_ADS=

# ─── 백엔드 API ──────────────────────────────────────────────────────────────
# 별도 변수 없음. 프런트는 상대경로 /api/v1 로만 호출한다 (src/hooks/useApi.js).
#   - 개발: vite.config.js 의 proxy 가 /api → http://localhost:8000 으로 전달
#   - 배포: vercel.json 의 rewrites 가 /api/:path* → Railway 백엔드로 전달
# 백엔드 주소를 바꾸려면 위 두 파일을 수정할 것.
