<!--
  AndroidManifest.xml 의 <application> 안에 붙여넣는다.
  (TWA 프로젝트에는 INTERNET 권한이 이미 있으므로 별도 권한 추가는 필요 없다.)

  위젯 3종은 각자 provider·선택 액션·메타를 따로 가진다. 한 receiver 로 묶으면
  칩 브로드캐스트가 엉뚱한 위젯까지 갱신하고, 위젯 피커에도 하나만 뜬다.

  intent-filter 에 넣는 것들:
  - APPWIDGET_UPDATE : 위젯 추가/주기 갱신(30분)
  - USER_PRESENT     : 잠금 해제 순간 갱신. 오레오 이후 암시적 브로드캐스트 제한으로
                       기기에 따라 안 올 수 있어 "보너스"로만 기대한다.
  - WIDGET_SELECT_*  : 칩 탭(우리 앱이 자기 자신에게 보내는 브로드캐스트)
  - WIDGET_REFRESH_CALENDAR : 학사일정 위젯의 ↻

  android:name 의 앞 점(.)은 manifest 의 package 를 기준으로 하므로, Kotlin 파일을
  다른 하위 패키지에 두면 여기도 전체 경로로 바꿔야 한다.
-->
<receiver
    android:name=".TransitWidgetProvider"
    android:label="@string/widget_transit_label"
    android:exported="false">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="android.intent.action.USER_PRESENT" />
        <action android:name="kr.ac.tukorea.taljungwang.WIDGET_SELECT_TRANSIT" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/tal_widget_transit" />
</receiver>

