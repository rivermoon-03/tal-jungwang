<?xml version="1.0" encoding="utf-8"?>
<!--
  탈것:정왕 홈 위젯 (4×2 기준, 4×1로 줄면 행이 자동으로 잘림).
  색은 values/colors.xml + values-night/colors.xml 이 라이트/다크를 나눈다 —
  위젯 전용 색을 새로 만들지 않고 앱 semantic 토큰을 그대로 옮겨 썼다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- 헤더: 제목 + 새로고침 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/tj_ink"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="탈것:정왕" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="새로고침" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/tj_line" />

    <include layout="@layout/widget_row_1" />
    <include layout="@layout/widget_row_2" />
    <include layout="@layout/widget_row_3" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="13sp"
        android:textColor="@color/tj_mute"
        android:visibility="gone"
        android:text="지금은 운행 정보가 없어요" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:textSize="11sp"
        android:textColor="@color/tj_mute"
        android:text="" />
</LinearLayout>
