# ============================================================================
# backend/.env  — 이 파일을 .env 로 복사해서 채운다 (.env 는 커밋 금지)
#
#   cp backend/.env.example backend/.env
#
# 이 파일은 docker-compose.yml 의 postgres / redis / backend / grafana 서비스가
# env_file 로 함께 읽는다. 따라서 백엔드 Settings 항목뿐 아니라 컨테이너
# 초기화용 변수(POSTGRES_*, GF_SECURITY_*)도 여기에 있다.
#
# [필수] 표시 항목은 기본값이 없어서 비우면 서버가 부팅되지 않는다.
#        (backend/app/core/config.py 의 Settings)
# 주의: 값 뒤에 인라인 주석(`값  # 설명`)을 붙이지 말 것 — Docker Compose 의
#       env_file 파서는 이를 값의 일부로 읽는다. 주석은 항상 별도 줄에.
# ============================================================================

# ─── 카카오 ─────────────────────────────────────────────────────────────────
# Kakao Developers (https://developers.kakao.com) → 내 앱 → 앱 키 → REST API 키
KAKAO_MOBILITY_REST_KEY=

# ─── TMAP ───────────────────────────────────────────────────────────────────
# T Developers (https://openapi.sk.com) → 마이페이지 → 앱 관리 → 앱 키
TMAP_APP_KEY=

# ─── 공공데이터포털 — 경기도 버스 + TAGO 지하철 + 기상청 단기예보 ───────────
# 공공데이터포털 (https://www.data.go.kr) → 마이페이지 → Open API → 인증키
# 버스도착정보, 버스위치정보, TAGO 지하철정보, 기상청 단기예보가 모두 이 키 하나를
# 공유한다 (app/services/external/kma.py 포함). 단, 각 API 활용 신청은 별도로 필요.
DATA_GO_KR_SERVICE_KEY=

# ─── 서울 지하철 API ────────────────────────────────────────────────────────
# 서울교통공사 OpenAPI (https://topis.seoul.go.kr) → 인증키 발급
SEOUL_SUBWAY_KEY=

# ─── Web Push (VAPID) — 노선 알림(막차/첫차 푸시) ───────────────────────────
# 생성: pip install py-vapid && vapid --gen
# (또는 pywebpush 설치 후 파이썬 콘솔에서 py_vapid.Vapid01().generate_keys() 사용)
# 생성된 private_key.pem/public_key.pem 을 base64url(URL-safe, 패딩 없음)로 인코딩해 입력.
# 공개키는 프런트가 GET /api/v1/push/vapid-public-key 로 받아가므로 프런트 .env 에 넣지 않는다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── 데이터베이스 ───────────────────────────────────────────────────────────
# [필수] DB_HOST / DB_NAME / DB_USER / DB_PASSWORD
# docker-compose 로 띄우면 backend 컨테이너의 DB_HOST 는 postgres 로 자동 덮어써진다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transit_hub
DB_USER=
DB_PASSWORD=
# Docker postgres 컨테이너 초기화용 (위 DB_NAME/DB_USER/DB_PASSWORD 와 동일 값 유지)
POSTGRES_DB=transit_hub
POSTGRES_USER=
POSTGRES_PASSWORD=

# ─── Redis ──────────────────────────────────────────────────────────────────
# [필수] REDIS_HOST
# docker-compose 로 띄우면 backend 컨테이너의 REDIS_HOST 는 redis 로 자동 덮어써진다.
# REDIS_PASSWORD 를 비우면 redis 가 인증 없이 뜬다 (로컬 전용, 프로덕션에서는 반드시 설정).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── 관리자 인증 (JWT) ───────────────────────────────────────────────────────
# [필수] ADMIN_USERNAME / ADMIN_PASSWORD_HASH / JWT_SECRET_KEY
ADMIN_USERNAME=admin
# bcrypt 해시 값 (평문 절대 입력 금지)
# 생성: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PW', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=CHANGE_ME_bcrypt_hash
# 생성: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ─── 앱 설정 ────────────────────────────────────────────────────────────────
# ENVIRONMENT: development | production
# production 이면 rate limit 이 활성화되고, ALLOWED_ORIGINS 의 '*' 는 부팅 실패로 막힌다.
ENVIRONMENT=development
# 쉼표 구분. [필수]
# 프로덕션 예시: https://taljungwang.kr,https://www.taljungwang.kr
ALLOWED_ORIGINS=http://localhost:5173

# 1/true/yes 면 스케줄러·수집 작업을 끄고 read-only 모드로 뜬다 (DB write 없음).
# 프로덕션 DB 를 바라보는 로컬/복제 인스턴스에서 중복 수집을 막을 때 사용.
DISABLE_SCHEDULER=

# ─── 모니터링 (개발용, 프로덕션에서는 강력한 비밀번호 사용) ──────────────────
# Grafana 컨테이너 초기 관리자 계정
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_strong_password
# /metrics 엔드포인트 Bearer 토큰 (생성: openssl rand -hex 32)
# 비우면 /metrics 가 무인증으로 열린다.
METRICS_TOKEN=CHANGE_ME_openssl_rand_hex_32
# pgAdmin 컨테이너용. 현재 docker-compose.yml 에 pgadmin 서비스는 없고
# infra/pgadmin-servers.json 만 남아 있다 — 직접 띄울 때만 사용.
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_strong_password

# ─── Discord 웹훅 (버스 도착 수집 모니터링) ──────────────────────────────────
# 생성: 디스코드 채널 설정 → 연동 → 웹훅
DISCORD_WEBHOOK_URL=

# ─── Discord 웹훅 (서버 WARNING/ERROR 알림) ──────────────────────────────────
DISCORD_ERROR_WEBHOOK_URL=
